{
  "name": "returnwise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "preview": "vite preview",
    "check:worker": "node scripts/check-s3-worker.mjs",
    "test:browser": "playwright test --config=playwright.config.mjs",
    "release:preflight": "node scripts/s6_release_preflight.mjs",
    "release:authorize:free": "node scripts/s6_release_preflight.mjs --require-ready=FREE",
    "release:authorize:pro": "node scripts/s6_release_preflight.mjs --require-ready=PRO"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.21.5",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.4.5"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
